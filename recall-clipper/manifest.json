{
  "manifest_version": 3,
  "name": "Recall Web Clipper",
  "version": "2.4.1",
  "minimum_chrome_version": "118",
  "description": "Bring any web page into Recall: clean it up, copy any part as Markdown for a file's Notes, or save it as a PDF with smart page breaks.",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "downloads",
    "offscreen",
    "storage"
  ],
  "action": {
    "default_title": "Recall Web Clipper — clean, copy as Markdown or save as PDF",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["vendor/katex/fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open Recall Web Clipper"
    },
    "toggle-clipper": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Copy as Markdown: pick content on the current page"
    },
    "toggle-cleaner": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Clean the current page"
    },
    "save-pdf": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Save the current page as a PDF with your last options"
    }
  }
}
